# https://editorconfig.org — matches the Prettier settings in .prettierrc (2 spaces, LF).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false
