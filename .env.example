# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the app
# bundle: never put a secret here. EAS builds take them from EAS environments.

# The API's base URL, no trailing slash. See docs/development.md,
# "Reaching the local API": iOS simulator http://localhost:3000, Android
# emulator http://10.0.2.2:3000, a real phone http://<LAN IP>:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
