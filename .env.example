# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_* values are inlined into the app
# bundle: never put a secret here. EAS builds take them from EAS environments.

# The API's base URL, no trailing slash. See docs/development.md,
# "Reaching the local API": iOS simulator http://localhost:3000, Android
# emulator http://10.0.2.2:3000, a real phone http://<LAN IP>:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# The web app's origin, no trailing slash: a notification's link (a web app
# path such as /notes/123) opens there. Leave empty to not open links.
EXPO_PUBLIC_WEB_URL=

# The iOS bundle identifier and Android package (app.config.ts), e.g.
# dev.example.app. Empty: the template's placeholder com.example.nestjsmobile.
APP_ID=

# Passkeys in the app: the API's domain is linked (iOS Associated Domains),
# which a free Apple team can't sign for a real device. `off` leaves it out
# for such builds (the simulator signs it). Empty: on.
PASSKEYS=
