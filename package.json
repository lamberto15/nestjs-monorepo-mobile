{
  "name": "nestjs-monorepo-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@tanstack/react-query": "5.105.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "26.5.11",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "client:sync": "node scripts/client-sync.mjs",
    "client:check": "node scripts/client-sync.mjs --check",
    "prepare": "lefthook install"
  },
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
